<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- The release RIDs (release.yml), so packages.lock.json covers their publish and package.yml restores it locked. -->
    <RuntimeIdentifiers>win-x64;linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
    <!-- Release packages precompile Varia and its packages, which are otherwise JIT-compiled on every launch and first
         connect, execute and Script As. Only a RID-specific publish: builds and checks stay IL. -->
    <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.91.1" />
    <PackageReference Include="Microsoft.SqlServer.SqlManagementObjects" Version="181.36.0" />
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.140.0" />
    <!-- SqlClient 7.1.1 resolves 9.0.18, which CVE-2026-84008 and CVE-2026-70162 affect; remove once SqlClient pulls a patched version. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- Generated from src/shared/explorer/catalog.ts by tests/explorer-catalog.test.ts. -->
    <EmbeddedResource Include="Explorer/explorer-catalog.json" LogicalName="Varia.Backend.Explorer.explorer-catalog.json" />
    <!-- Generated from src/shared/scripting/catalog.ts by tests/scripting-catalog.test.ts. -->
    <EmbeddedResource Include="Scripting/scripting-catalog.json" LogicalName="Varia.Backend.Scripting.scripting-catalog.json" />
    <!-- Generated from src/shared/actions/catalog.ts by tests/object-actions-catalog.test.ts. -->
    <EmbeddedResource Include="Actions/actions-catalog.json" LogicalName="Varia.Backend.Actions.actions-catalog.json" />
    <!-- Generated from src/shared/ssis/catalog.ts by tests/ssis-catalog.test.ts. -->
    <EmbeddedResource Include="Ssis/ssis-catalog.json" LogicalName="Varia.Backend.Ssis.ssis-catalog.json" />
    <!-- Generated from src/shared/designer/catalog.ts by tests/table-designer-catalog.test.ts. -->
    <EmbeddedResource Include="Designer/designer-catalog.json" LogicalName="Varia.Backend.Designer.designer-catalog.json" />
    <!-- Generated from src/shared/activity/catalog.ts by tests/activity-catalog.test.ts. -->
    <EmbeddedResource Include="Activity/activity-catalog.json" LogicalName="Varia.Backend.Activity.activity-catalog.json" />
    <!-- Generated from src/shared/live/catalog.ts by tests/live-catalog.test.ts. -->
    <EmbeddedResource Include="Live/live-catalog.json" LogicalName="Varia.Backend.Live.live-catalog.json" />
  </ItemGroup>
</Project>
