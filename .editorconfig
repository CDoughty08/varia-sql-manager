root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.cs]
indent_size = 4

# Golden scripts are compared byte for byte; EXECUTE templates end a line with a space, as SSMS writes them.
[tests/fixtures/scripting/golden/**.sql]
trim_trailing_whitespace = false
